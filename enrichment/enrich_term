def this_time():
	timeformat = "%Y-%m-%d %H:%M:%S"
	return time.strftime(timeformat, time.localtime())

def parse_species(species):
	for line in open('/nas/database/species.xls', 'r'):
		line = line.strip().split('\t')
		if species in line:
			taxid = line[0]
			sp = line[1]
			ks = line[2]
			orgdb = line[3]
	return taxid,sp,ks,orgdb

def parse_dir(deg_dir):
	print("Detect the DEG gene list files in the DEG direction!")
	all_dirs = [deg_dir + "/" + i for i in list(os.listdir(deg_dir))]
	gene_files = list()
	pattern = re.compile("sig.*genes.xls")
	for dir in all_dirs:
		if os.path.isdir(dir):
			for file in os.listdir(dir):
				if pattern.findall(file):
					gene_files.append(dir + "/" + file)
			gene_files.append(dir + "/Gene_expr_diff.xls")
	gene_files = ",".join(gene_files)
	return gene_files


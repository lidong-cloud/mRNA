def main():
    if gene_list_files:
        gene_files = gene_list_files
    else:
        gene_files = parse_dir(deg_dir)

    os.makedirs(outdir) if not os.path.exists(outdir) else ""
    gene_files = gene_files.split(",")
    file = []
    for i in gene_files:
        new = i + ',' + species + ',' + str(pcut) + ',' + outdir
        file.append(new)

    with multiprocessing.Pool(processes=20) as pool:
                pool.map(enrich, file)


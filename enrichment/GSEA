Create_database <- function(sp,ks,database,str,db){
  data <- msigdbr(species = sp,subcollection = database) %>%
    mutate(Term=gsub(str,'',gs_name)) %>% dplyr::select(gs_exact_source,Term,gene_symbol)
  data <- data[!duplicated(data),] %>% arrange(gs_exact_source,gene_symbol)
  colnames(data) <- c('ID','Term','Symbol')
  df <- left_join(data,db,by = 'ID')
  df$Term <- if_else(is.na(df$Term.y),df$Term.x,df$Term.y)
  if (str=='KEGG_') {df$ID <- gsub('hsa',ks,df$ID)}
  return(df[c('ID','Term','Symbol')])
}

Sort_database <- function(species,rebuild){
  file <- read.csv('/nas/database/species.xls',sep = '\t',header = F)
  for (i in 1:nrow(file)) {if(length(unique(grepl(species,file[i,])))>1){sp = file[i,2];ks = file[i,3];break}}

  database_file <- paste0('/nas/database/GSEA/',sp,'.GSEA.db')
  if (!file.exists(database_file) | rebuild == T){
    cat("\n<==========================Construction database==========================>\n\n")
    go <- read.csv('/nas/database/Database.GO.xls',sep = '\t',header = F)
    kegg <- read.csv('/nas/database/Database.KEGG.xls',sep = '\t',header = F)
    names(go) <- c("ID","Term","Database");names(kegg) <- c("ID","Term")
    GOBP <- Create_database(sp,ks,'GO:BP','GOBP_',go)
    GOCC <- Create_database(sp,ks,'GO:CC','GOCC_',go)
    GOMF <- Create_database(sp,ks,'GO:MF','GOMF_',go)
    KEGG <- Create_database(sp,ks,'CP:KEGG_LEGACY','KEGG_',kegg)
    database <- list(list(GOBP,'GOBP'),list(GOCC,'GOCC'),list(GOMF,'GOMF'),list(KEGG,'KEGG'))
    save(database,file = database_file)
    cat("\n<=====================Database construction completed=====================>\n\n")
  } else {
    load(file = database_file)
    cat("\n<=======================Database loading completed========================>\n\n")
  }
  return(database)
}

Sort_genedata <- function(gfile){
    df <- read.table(gfile,header = T,sep = '\t')
    logFC <- grep('logfc',colnames(df),ignore.case=T)
    gene <- df[,logFC]
    names(gene) <- df[,1]
    gene <- sort(gene,decreasing = T)
    if(ncol(df)>10){exp <- df[,c(1:(ncol(df)-6))]}else {exp <- as.data.frame(df[,1])}
    colnames(exp)[1] <- 'Geneid'
    return(list(gene,exp))
}

Write_gsea <- function(GSEA,outdir,database){
    gsea <- as.data.frame(GSEA) %>%
        mutate(core_size=lengths(strsplit(core_enrichment,'/')))
    f<-function(x) paste(names(sort(GSEA@geneList[intersect(x,names(GSEA@geneList))],decreasing = T)),collapse='/')
    gsea$set_gene <- sapply(GSEA@geneSets[GSEA@result$ID],f)

    gsea <- gsea[,c("ID","Description","core_size","setSize","rank","enrichmentScore","NES","pvalue","p.adjust","qvalue","core_enrichment","set_gene")]
    colnames(gsea) <- c("ID","Term","Core_size","Set_size","Rank","ES","NES",
        "pvalue","p.adjust","qvalue","Core_gene","Set_gene")
    write.table(gsea,paste0(outdir,'/GSEA.',database,'.enrich_result.xls'), 
        sep ="\t",quote=F,col.names =T,row.names=F)
    return(gsea)
}

plot_title <- function(GSEA,n){
    if (nchar(GSEA$Description[n])>40) {
        t <- strsplit(GSEA$Description[n],' ')[[1]]
        t1 <- paste(t[1:round(length(t)/2,digits = 0)],collapse = ' ')
        t2 <- paste(t[(round(length(t)/2,digits = 0)+1):length(t)],collapse = ' ')
        title <- paste0(t1,'\n',t2,'\n(',GSEA$ID[n],')')
    } else if(nchar(GSEA$Description[n])>14){
        title <- paste0(GSEA$Description[n],'\n(',GSEA$ID[n],')')
    } else{title <- paste0(GSEA$Description[n],'(',GSEA$ID[n],')')}
    
    return(title)
}

plot_bubble <- function(gsea,outdir,database){
    gsea <- gsea[order(abs(gsea$NES),decreasing = T),]
    if(nrow(gsea)<12){gsea <- gsea}else{gsea <- gsea[1:12,]}
    
    gsea$Term <- factor(gsea$Term,level=rev(gsea$Term))
    p <- ggplot(gsea, aes(abs(NES), Term))+
    geom_point(aes(size=Core_size, color=-log10(pvalue)))+
    xlab('abs(NES)')+ylab("Terms")+
    ggtitle(paste0('GSEA ',database))+
    scale_color_gradient(low = "blue",high="red")+
    theme(axis.text=element_text(size=7))+
    scale_y_discrete(labels=function(y) lapply(strwrap(y,width=40,simplify=FALSE),paste,collapse="\n"))+
    labs(colour = "- log10(pvalue)", size="Core size")+ 
    guides(color= guide_colourbar(order = 1),size = guide_legend(order = 2))+
    theme_bw() + theme(axis.text=element_text(size=12))
    
    pdf_file <- paste0(outdir,'/GSEA.',database,'.enrich_result.pdf')
    chr_n <- max(nchar(as.vector(gsea$Term)))
    if(chr_n>90){w=7.5;h=6}else if(chr_n>45){w=7.5;h=5.5}else if(chr_n>40){w=7.8;h=5}else if(chr_n>35){w=7.4;h=5}else if(chr_n>30){w=6.8;h=5}
    else if(chr_n>25){w=6.2;h=5}else if(chr_n>20){w=5.7;h=5}else{w=5;h=5}
    pdf(pdf_file,w=w,h=h)
    print(p);dev.off()
}

plot_gsea <- function(GSEA,title,n,datadir,gene_n,comp){
    y <- GSEA$enrichmentScore[n]
    if (y>0) {x=gene_n*0.15} else {x=gene_n*0.45}
    comp <- strsplit(comp,'__')[[1]]

    p<-gseaplot2(GSEA,geneSetID = n,title = title,color = "#008b38",subplots = 1:3,base_size = 10)
    p[[1]] <- p[[1]]+theme_test()+theme(plot.title = element_text(hjust = 0.5,size = 15),
            legend.position = 'none',axis.title.y = element_text(size=14),
            axis.ticks.x = element_blank(),axis.text.x = element_blank(),
            plot.margin = margin(b = 0, r = 20)) +
        annotate("text",x=x,y=y*0.34,hjust=0,size=4.5,
            label = paste0('ES: ',round(GSEA$enrichmentScore[n],digits = 4))) +
        annotate("text",x=x,y=y*0.20,hjust=0,size=4.5,
            label = paste0('NES: ',round(GSEA$NES[n],digits = 4))) +
        annotate("text",x=x,y=y*0.06,hjust=0,size=4.5,
            label = paste0('Pvalue: ',round(GSEA$pvalue[n],digits = 4)))
    p[[2]] <- p[[2]] + theme_test()+theme(legend.position = 'none',
            axis.ticks.x = element_blank(),
            axis.text.x = element_blank(),
            axis.ticks.y = element_blank(),
            axis.text.y = element_blank(),
            plot.margin = margin(t=0, b=0, r = 20))
    p[[3]] <- p[[3]] + theme_test()+theme(legend.position = 'none',
            axis.ticks.x = element_blank(),axis.text.x = element_blank(),axis.title.x = element_text(size=14),
            axis.title.y = element_text(size=14),plot.margin = margin(t=0, r = 20)) +
        annotate("text",x=gene_n/6,y=-0.3,hjust=0.5,vjust=1,size=4.5,
               label = comp[2],color='red')+
        annotate("text",x=gene_n*5/6,y=0.3,hjust=0.5,vjust=0,size=4.5,
               label = comp[1],color='blue')
    Term <- gsub('/','_',gsub(' ','_',gsub(',','_',gsub('-','_',GSEA@result$Description[n]))))
    if (nchar(GSEA$Description[n])>40) {h=4.9} else if(nchar(GSEA$Description[n])>14){h=4.7} else{h=4.5}
    pdf(paste0(datadir,'/',Term,'.',gsub(':','_',GSEA$ID[n]),'.gsea.pdf'),w=4,h=h)
    print(p);dev.off()
}

plot_heatmap <-  function(gsea,exp,config_file,title,n,datadir,comp){
    gene <- as.data.frame(strsplit(gsea[n,"Set_gene"],'/')[[1]])
    rownames(exp) <- exp[,1];exp <- exp[,-1];df <- exp[gene[,1],]
    for (i in 1:nrow(df)) {df[i,] <- scale(as.numeric(df[i,]))};df[df > 3] = 3;df[df < -3] = -3

    Group <- read.csv(config_file,sep = '\t',header = F,row.names = 1)[colnames(df),'V2']
    Group <- unlist(strsplit(Group,';'))[unlist(strsplit(Group,';')) %in% strsplit(comp,'__')[[1]]]
    col <- c("#00A087FF", "#E64B35FF", "#3C5488FF", "palevioletred", "#7E6148FF", "lightblue", "#F39B7FFF")
    names(col) <- unique(Group)
    group = HeatmapAnnotation(group = Group,col = list(group = col[1:length(unique(Group))]),show_annotation_name = F,
                              annotation_legend_param = list(title_gp = gpar(fontsize = 18),labels_gp = gpar(fontsize = 15)),simple_anno_size = unit(0.2, "cm"))
    col_fun <- colorRampPalette(rev(brewer.pal(n = 7, name ="RdYlBu")))(100)

    #show_column <- ifelse(ncol(df)<10,T,F)
    #show_row <- ifelse(nrow(df)<30,T,F)
    p <- Heatmap(df,border = F,show_heatmap_legend = T,use_raster = F,
            heatmap_legend_param = list(title = "",title_position = "leftcenter-rot",legend_height = unit(9, "cm")),
            show_row_names = F,show_column_names = F,cluster_rows = F,cluster_columns = F,
            column_names_rot = 60,top_annotation = group,col = col_fun,column_title = title,
            column_title_gp = gpar(fontsize = 18))

    Term <- gsub('/','_',gsub(' ','_',gsub(',','_',gsub('-','_',gsea$Term[n]))))
    heatmap_file <- paste0(datadir,'/',Term,'.',gsub(':','_',gsea$ID[n]),'.heatmap.pdf')
    if (nchar(gsea[n,2])>40) {h=5.8} else if(nchar(gsea[n,2])>14){h=5.5} else{h=5.2}
    pdf(heatmap_file,w=4,h=h)
    draw(p, merge_legend = TRUE);dev.off()
}

GSEA_ananysis <-  function(database,gene,exp,outdir,Termid,Padj,number,comp,config_file){
    unlink(outdir,recursive = T);dir.create(outdir)
    for (i in database) {
        print(paste0('Perform GSEA analysis of this database: ',i[[2]]))
        cat("<------------------------------------------------------------------------->\n\n")
        data<-i[[1]]
        if (!is.na(Termid)) {
            cat("\n<------------------------>\n")
            print('We processed the database according to the Termid information you provided')
            cat("<------------------------>\n\n")
            id <- as.data.frame(read.table(Termid,header = F,sep = '\t')[,1])
            colnames(id) <- 'ID'
            data <- inner_join(data,id,by=('ID'))
        }

        if (nrow(data)>0) {
            datadir <- paste0(outdir,'/',i[2])
            if (!file.exists(datadir)){dir.create(datadir)}
    
            GSEA <- GSEA(gene,TERM2GENE=data[,c(1,3)],
                TERM2NAME=data[,c(1,2)],
                minGSSize = 10,maxGSSize = 500,
                pvalueCutoff = Padj,
                pAdjustMethod = "fdr")
    
            if (nrow(GSEA@result)>0) {
                gsea <- Write_gsea(GSEA,outdir,i[2])
                cat('\n');print(paste0(i[[2]],': Enrichment analysis of this database has been completed, and drawing has begin'));cat('\n\n')
                plot_bubble(gsea,outdir,i[2])
                gene_n <- length(gene)
                for (n in 1:min(nrow(GSEA@result),number)) {
                    title <- plot_title(GSEA,n)
                    plot_gsea(GSEA,title,n,datadir,gene_n,comp)
                    if(ncol(exp)>1 & !is.na(config_file)){plot_heatmap(gsea,exp,config_file,title,n,datadir,comp)}
                }
            } else {cat('\n');print(paste0(i[[2]],": This database has no Terms enriched, so it can't be drawn!!!"));cat('\n\n')}
        } else {cat('\n');print("You provided Termid that does not exist in the database, so we just skipped the database");cat('\n\n')}
    }
}

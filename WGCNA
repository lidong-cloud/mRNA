WGCNA_step1 <- function(expression, config, ngene, WGCNA_dir){
  cat("\n\n<==========================Running WGCNA step one==========================>\n\n")
  W1_dir <- paste0(WGCNA_dir,'/1.Module/')
  if (!dir.exists(W1_dir)){dir.create(W1_dir)}

  datExpr <- data_filter(expression, ngene, WGCNA_dir);dim(datExpr)
  power0 <- select_power(datExpr, WGCNA_dir, Soft_cut)
  
  net <- construct_network(datExpr, power0, WGCNA_dir)
  load(net$TOMFiles[1], verbose=T)
  TOM <- as.matrix(TOM)
  if (file.exists(net$TOMFiles[1])){file.remove(net$TOMFiles[1])}
  
  moduleLabels = net$colors
  moduleGenes = names(moduleLabels)
  moduleColors = labels2colors(moduleLabels)
  MEs = orderMEs(moduleEigengenes(datExpr, moduleColors)$eigengenes)
  
  modules_file = data.frame(moduleGenes, moduleLabels, moduleColors)[net$goodGenes,]
  write.table(modules_file, paste0(W1_dir, "/gene_module.xls"), 
              row.names=FALSE, sep="\t",quote=F)
  write.table(cbind(sample=row.names(MEs),MEs), paste0(W1_dir, "/Sample_expression_pattern_MEs.xls"), 
              row.names=FALSE, sep="\t",quote=F)
  
  basic_plot(net,moduleColors,MEs,config,W1_dir)
  
  get_network(TOM, moduleLabels, moduleColors, W1_dir)
  
  network_heatmap(TOM, moduleColors, power0, W1_dir)
  
  qs_save(list(datExpr, power0, net, moduleGenes, moduleLabels, moduleColors, MEs, TOM),
       file = paste0(WGCNA_dir, "/WGCNA_1.qs2"))
  cat("\n<=========================WGCNA step one completed=========================>\n\n\n")
  
  return(paste0(WGCNA_dir, "/WGCNA_1.Rdata"))
}

WGCNA_step2 <- function(w1_Rdata, trait_file, WGCNA_dir){
  cat("\n\n<==========================Running WGCNA step two==========================>\n\n")
  cat('Analyze the correlation between module and phenotype\n')
  W2_dir <- paste0(WGCNA_dir,'/2.Trait/')
  if (!dir.exists(W2_dir)){dir.create(W2_dir)}
  
  df <- qs_read(w1_Rdata)
  datExpr <- df[[1]]; power0<- df[[2]]; net<- df[[3]]; moduleGenes<- df[[4]]; moduleLabels<- df[[5]]; moduleColors<- df[[6]]; MEs<- df[[7]]; TOM<- df[[8]]

  datTraits <- as.matrix(read.table(trait_file, header = TRUE, row.names = 1, sep = "\t", quote = ""))
  sampleName = intersect(rownames(datExpr),rownames(datTraits))
  datExpr <- datExpr[sampleName, ];MEs <- MEs[sampleName,]

  traitname <- colnames(datTraits);datTraits <-  data.frame(datTraits[sampleName,])
  colnames(datTraits) <- traitname;rownames(datTraits) <- sampleName
  for(i in 1:ncol(datTraits)){if(is.character(datTraits[,i])) {datTraits[,i] <- as.numeric(factor(datTraits[,i]))}}

  correlation <- trait_correlation(MEs, datTraits, W2_dir)

  plot_correlation(correlation[[1]], correlation[[2]], W2_dir)
  
  degree_GS_MM(datExpr, datTraits, power0, moduleColors, MEs, W2_dir)
  cat("\n<=========================WGCNA step two completed=========================>\n\n\n")
}

WGCNA_step3 <- function(WGCNA_dir,module,phenotype,GS_cut,degree_cut,MM_cut){
  cat("\n<=========================Running WGCNA step three=========================>\n\n")
  cat("loading data......\n\n")
  W3_dir <- paste0(WGCNA_dir,'/3.hubgene_net/')
  if (!dir.exists(W3_dir)){dir.create(W3_dir)}
  allgene <- read.table(paste0(WGCNA_dir,'/2.Trait/degree_GS_MM.xls'),header = T,sep = '\t')
  allnet <- readr::read_tsv(paste0(WGCNA_dir,'/1.Module/Allgene_CytoscapeInput_edges.txt'))
  cat("\nloading complete......\n")
  colnames(allgene) <- sapply(colnames(allgene),f<-function(x) strsplit(x,'_')[[1]][1])
  module <- strsplit(module,',')[[1]]
  phenotype <- strsplit(phenotype,',')[[1]]
  
  n<-length(module)
  open_pdf(WGCNA_dir,MM_cut,n)
  
  for (i in 1:n) {
    modulegene <- allgene[allgene$module==module[i],c('Geneid','module','degree',phenotype[i],module[i])]
    colnames(modulegene) <- c('Geneid','module','degree','GS','MM')
    modulegene$trait <- phenotype[i]
    modulegene <- modulegene[,c('Geneid','module','trait','degree','GS','MM')]
    
    if (MM_cut==0) {
      x<-modulegene$degree;xlab<-"Connectivity";v<-degree_cut
      hubgene <- modulegene[modulegene$degree>degree_cut & abs(modulegene$GS)>GS_cut,]
    } else {
      x<-abs(modulegene$MM);xlab<-"Module Membership";v<-MM_cut
      hubgene <- modulegene[abs(modulegene$MM)>MM_cut & abs(modulegene$GS)>GS_cut,]
    }
    verboseScatterplot(x, abs(modulegene$GS), col=module[i],
                       main=paste(unique(modulegene$module),'and',phenotype[i],'\n'), 
                       xlab = xlab, ylab = "Gene Significance", 
                       cex.lab = 2.5, cex.main = 2.5,
                       pch = 21)
    abline(h=GS_cut, v=v, col = "gray30", lwd = 2, lty = 2)
    write_data(WGCNA_dir,allnet,hubgene,module[i],phenotype[i])
  }
  dev.off()
  cat("\n<========================WGCNA step three completed========================>\n\n\n")
}

get_network <- function(TOM, moduleLabels, moduleColors, W1_dir){
  modgene = names(moduleLabels)
  modlabel = moduleLabels
  
  cyt <- exportNetworkToCytoscape(TOM,
                           weighted = TRUE,
                           threshold = 0.2, # 调整 threshold 参数会影响网络中节点数目
                           nodeNames = modgene,
                           altNodeNames = moduleColors,
                           nodeAttr = modlabel)
  edge <- cyt$edgeData
  colnames(edge) <- c("Geneid1","Geneid2","weight","direction","module1","module2")
  write.table(edge, paste0(W1_dir, "/Allgene_CytoscapeInput_edges.txt"), 
              row.names=FALSE, sep="\t", quote=FALSE)
}

network_heatmap <- function(TOM, moduleColors, power0, W1_dir){
  dissTOM = 1-TOM
  
  if (ncol(TOM)>1000) {select = floor(seq(1,ncol(TOM),ncol(TOM)/999))} else {
    select = seq(1,ncol(TOM))}
  selectTOM = dissTOM[select, select]
  selectTree = hclust(as.dist(selectTOM), method = "average")
  selectColors = moduleColors[select]
  
  plotTOM = selectTOM^power0
  diag(plotTOM) = NA
  pdf(paste0(W1_dir, "/Network_heatmap.pdf"))
  TOMplot(plotTOM, selectTree, selectColors, main = "")
  dev.off()
}

trait_correlation <- function(MEs, datTraits, W2_dir){
  modTraitCor = cor(MEs, datTraits, use = "p")
  modTraitP = corPvalueStudent(modTraitCor, nrow(MEs))
  
  data <- cbind(row.names(modTraitCor),modTraitCor,modTraitP)
  colnames(data) <- c('module',paste(colnames(modTraitCor),'_cor',sep = ''),paste(colnames(modTraitCor),'_pvalue',sep = ''))
  write.table(data, paste0(W2_dir, "/module_trait_relationship.xls"), 
              sep ="\t", quote=F, col.names = T, row.names = F)
  
  return(list(modTraitCor,modTraitP))
}

plot_correlation <- function(modTraitCor, modTraitP, W2_dir){
  modTraitP[modTraitP<0.001] <- '***'
  modTraitP[modTraitP<0.01 & modTraitP >= 0.001] <- '**'
  modTraitP[modTraitP<0.05 & modTraitP >= 0.01] <- '*'
  modTraitP[modTraitP >= 0.05] <- ''
  textMatrix = paste("\n", round(modTraitCor, 3), "\n", modTraitP, sep = "")
  #if (ncol(modTraitP)>16) {textMatrix = paste(round(modTraitCor, 3))}
  dim(textMatrix) = dim(modTraitCor)
  
  value <- min(max(abs(modTraitCor)),1)
  pdf(paste0(W2_dir, "/module_trait_relationship.pdf"), 
      width = 3+0.8*ncol(modTraitCor), height = 10.5)
  par(mar = c(8, 11.2, 3, 1))
  labeledHeatmap(modTraitCor, xLabels = colnames(modTraitCor), 
                 yLabels = row.names(modTraitCor), 
                 ySymbols = row.names(modTraitCor), 
                 colorLabels = F, 
                 colors = blueWhiteRed(50), 
                 textMatrix = textMatrix, setStdMargins = F, 
                 cex.lab = 1.5,cex.text = 1,
                 zlim = c(-value,value),
                 main = '')
  if(ncol(modTraitCor)<4){
    title(main = "Module-trait relationships", adj = 1, line = 1, cex.main = 2)
    }else if(ncol(modTraitCor)<6){
      title(main = "Module-trait relationships", adj = 0, line = 1, cex.main = 2)
      }else{title(main = "Module-trait relationships", adj = 0.4, line = 1, cex.main = 2)}
  
  dev.off()
}

degree_GS_MM <- function(datExpr, datTraits, power0, moduleColors, MEs, W2_dir){
  #计算基因表达量与基因基因表达量的相关性，连接度/连通性(degree)
  ADJ <- abs(cor(datExpr,use="p"))^power0
  degree <- intramodularConnectivity(ADJ, moduleColors)
  
  #计算基因表达量与性状的相关性(GS,geneTraitSignificance)
  GS <- as.data.frame(cor(datExpr, datTraits, use = "p"))
  names(GS) = paste(colnames(datTraits), "GS", sep="_")
  
  #计算基因表达量与模块第一主成分的相关性(MM,geneModuleMembership)
  modNames = substring(names(MEs), 3)
  MM = as.data.frame(cor(datExpr, MEs, use = "p"))
  names(MM) = paste(modNames, "MM", sep="_")
  
  data <- cbind(Geneid=row.names(degree),module=moduleColors,degree=degree$kWithin,GS,MM)
  write.table(data, paste0(W2_dir, "/degree_GS_MM.xls"), 
              row.names=FALSE, quote=F, sep="\t")
}

open_pdf <- function(WGCNA_dir,MM_cut,n){
  x<-1;y<-n
  if (n==4) {x<-2;y<-2}
  if (n>4) {x<-2;y<-3}
  if (n>6) {x<-ceiling(n/4);y<-4}
  
  if (MM_cut==0) {
    file <-  paste0(WGCNA_dir, "/2.Trait/GS_vs_degree_weight.pdf")
  } else {
    file <-  paste0(WGCNA_dir, "/2.Trait/GS_vs_MM_weight.pdf")
  }
  pdf(file,width =3.6*y, height = 4.1*x)
  par(mfrow=c(x,y))
  par(mar = c(5,5,5.5,2))
}


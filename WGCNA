data_filter <- function(expression, ngene, WGCNA_dir){
  datExpr <- data.frame(readr::read_tsv(expression)) %>% column_to_rownames(var = names(.)[1])
  f<-function(x) sum(x!=0)/length(x)
  datExpr <- t(datExpr[(apply(datExpr,1,f) >= 0.3),])
  
  gsg <- goodSamplesGenes(datExpr, verbose = 3,minNSamples = 3);cat('\n')
  if (!gsg$allOK){
    if (sum(!gsg$goodGenes)>0)
      printFlush(paste("Removing genes:", paste(colnames(datExpr)[!gsg$goodGenes], collapse = ", ")))
    if (sum(!gsg$goodSamples)>0)
      printFlush(paste("Removing samples:", paste(rownames(datExpr)[!gsg$goodSamples], collapse = ", ")))
    datExpr <- datExpr[gsg$goodSamples, gsg$goodGenes]
  }
  
  if (file.exists(paste0(dirname(expression),'/Normal__Tumor/All_Gene_expr.xls'))) {
    df <- readr::read_tsv(paste0(dirname(expression),'/Normal__Tumor/All_Gene_expr.xls'))
    diffgene <- df[(df$P.Value < 0.05)&(abs(df$logFC)) > 0.58,]$Geneid
    gene <- setdiff(colnames(datExpr),diffgene)
    SD <- sort(apply(datExpr[,gene], 2, sd, na.rm = TRUE),decreasing = T)[1:min(length(gene),ngene-length(diffgene))]
    gname <- c(diffgene,names(SD))
  }else{SD <- sort(apply(datExpr, 2, sd, na.rm = TRUE),decreasing = T)[1:min(ncol(datExpr),ngene)];gname <- names(SD)}
  newdata <- datExpr[,gname]
  write.table(cbind(sample=row.names(newdata),newdata), file =paste0(WGCNA_dir, "/datExpr.xls"), 
              sep ="\t", quote=F, col.names = T, row.names = F)
  
  sampleTree <- hclust(dist(newdata), method = "average")
  pdf(paste0(WGCNA_dir, "/Sample_Clustering.pdf"),max(0.25*nrow(datExpr),7))
  par(fig = c(0.01, 1, 0, 1))
  plot(sampleTree,hang=-1,main = "Sample hierarchical clustering tree", sub="",
       xlab="", cex.lab = 1.2,cex.axis = 1.2, cex.main = 1.5)
  dev.off()
  
  return(newdata)
}

select_power <- function(datExpr, WGCNA_dir, Soft_cut){
  powers <- c(1:22)
  sft <- pickSoftThreshold(datExpr, powerVector = powers, verbose = 5);dat <- sft$fitIndices

  if (Soft_cut=='best') {
    R2 <- abs(dat$SFT.R.sq)
    if (length(R2[R2>0.9])>0) {Soft_cut <- 0.9}else if(length(R2[R2>0.85])>0){Soft_cut <- 0.85}else{Soft_cut <- 0.8}
    cat(paste0('\n\n最佳R方值为:              >>>>>  ',Soft_cut,'  <<<<<'))
  }

  power0 <- powers[-sign(dat[,3])*dat[,2] > Soft_cut][1]
  if(is.na(power0)){power0 = 22}
  cat(paste0('\n\n最佳power值为:            >>>>>   ',power0,'   <<<<<\n\n\n'))

  p1<-ggplot(dat, aes(x = Power, y = abs(SFT.R.sq))) + 
    geom_point(size = 3.5, shape = 23, color = 'black',fill = 'blue') + 
    geom_line(size = 0.4)+ theme_classic()+
    geom_hline(yintercept = as.numeric(Soft_cut), lty=2, col="red",linewidth=0.7)+
    xlab("Soft Threshold (power)")+ylab(expression(paste("signed ", R^2)))+
    ggtitle('Scale Free Topology Model Fit')+
    theme(plot.title = element_text(size = 27,hjust = 0.5),
          axis.title = element_text(size = 26), 
          axis.text = element_text(size = 17))

  p2<-ggplot(dat, aes(x = Power, y = mean.k.)) + 
    geom_point(size = 3.5, shape = 23, color = 'black',fill = 'green') + 
    geom_line(size = 0.4)+ theme_classic()+
    xlab("Soft Threshold (power)")+ ylab("Mean Connectivity")+
    ggtitle('Mean Connectivity')+
    theme(plot.title = element_text(size = 27,hjust = 0.5),
          axis.title = element_text(size = 26), 
          axis.text = element_text(size = 17))

  pdf(paste0(WGCNA_dir, "/Scale_Free_Topology_Model_Fit.pdf"))
  print(p1/p2);dev.off()
  
  return(power0)
}

construct_network <- function(datExpr, power0, WGCNA_dir){
  nGenes <- ncol(datExpr)
  filename <- paste0(WGCNA_dir, "/TOM")
  net <- blockwiseModules(datExpr, power = power0,
                          TOMType = "signed", 
                          maxBlockSize = 8000,#单个块的最大基因数
                          minModuleSize = ceiling(nGenes/2000)*10,
                          deepSplit = 1, #划分模块的数量,值越大模块越多(0~4)
                          reassignThreshold = 0.1, #基因分模块后,根据与模块的相关度,重分模块阈值,值越小分越多（0:0.3,0.1）
                          mergeCutHeight = 0.30, #合并模块阈值,值越大合并越多(0.1:0.4,0.05)
                          numericLabels = TRUE, pamRespectsDendro = FALSE,
                          saveTOMs = TRUE,nThreads=20,
                          saveTOMFileBase = filename,
                          verbose = 3)
  return(net)
}


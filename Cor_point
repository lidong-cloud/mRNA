#!/nas/software/miniconda3/bin/Rscript
suppressPackageStartupMessages({
library(argparser)
})

parse <- arg_parser("===================================================================\nThis script is used to plot the expression correlation between two genes.\n===================================================================",hide.opts = T)

parse <- add_argument(parse, "--file", 
    help="Gene expression file of DEG results (such as: DEG/Treat__Control/All_Gene_expr.xls)")
parse <- add_argument(parse, "--xgene",
    help="The genes used to analyze expression correlation, as the X axis")
parse <- add_argument(parse, "--ygene",
    help="The genes used to analyze expression correlation, as the Y axis")
parse <- add_argument(parse, "--outdir",
    help="Output directory of this result,default='./GSE*_supp/Correlation/'")


argv <- parse_args(parse)
if(is.na(argv$file)|is.na(argv$xgene)|is.na(argv$ygene)){cat('\nThe parameters <file>,<xgene> and <ygene> is required\n\n');print(parse);quit()}
file <- argv$file
xgene <- argv$xgene
ygene <- argv$ygene

if (!is.na(argv$outdir)) {
  outdir <- argv$outdir
}else if(endsWith(strsplit(file,'/')[[1]][1],'_supp')) {
  outdir <- paste0(strsplit(file,'/')[[1]][1],'/Correlation/')
}else if(endsWith(strsplit(file,'/')[[1]][2],'_supp')) {
  outdir <- paste0(strsplit(file,'/')[[1]][2],'/Correlation/')
}else{outdir <- './supp/Correlation'}

suppressPackageStartupMessages({
library(stringr)
library(ggplot2)
library(ggpmisc)
library(ggpubr)
})

# file <- 'G:/Ledug/Desktop/b-handle/DSZQK240727A/All_Gene_expr.xls'
# gene <- 'PDLIM3,CXCL14'
# outdir <- 'G:/Ledug/Desktop/b-handle/DSZQK240727A/'

Plot_Correlation <- function(exp,gene,group,outdir){
  df <- as.data.frame(t(exp[gene,1:(ncol(exp)-6)]))
  colnames(df) <- c('x','y')
  m <- max(df$y) - min(df$y)

  p <- ggplot(df, aes(x, y)) + geom_point(colour = "#E64B35FF") +
    geom_smooth(formula = y ~ x, method = "lm", color = "black", fill = "lightgray") + 
    theme_bw() +
    scale_y_continuous(expand = c(0,0),limits = c(min(df$y)-m/15,max(df$y)+m/15)) +
    stat_poly_eq(label.y = 0.97,
      aes(label=paste(after_stat(eq.label),sep = "~~~~~~")),
      formula = y~x,parse=T,size=5.5) +
    stat_cor(label.y = min(df$y)+0.90*(max(df$y)-min(df$y)),size=5.5) +
    xlab(paste0('Exp of ', gene[1])) + ylab(paste0('Exp of ', gene[2])) +
    theme(axis.title = element_text(size = 15))
  
  pdf(paste0(outdir,'/',group,'.',gene[1],'_',gene[2],'.correlation.pdf'),w=3.4,h=3.5)
  print(p);dev.off()
}
##########################################################################################
if(!file.exists(outdir)){dir.create(outdir)}
exp <- read.csv(file,sep = '\t',header = T,row.names = 1)
group <- gsub('__','_VS_',basename(dirname(file)))

for(x in strsplit(xgene,',')[[1]]){
  for(y in strsplit(ygene,',')[[1]]){
    if(x!=y){
      if(names(which.max(table(rownames(exp) == str_to_upper(rownames(exp)))))){
        x <- str_to_upper(x);y <- str_to_upper(y)} else if(names(which.max(table(rownames(exp) == str_to_lower(rownames(exp)))))){
        x <- str_to_lower(x);y <- str_to_lower(y)} else{x <- str_to_title(x);y <- str_to_title(y)}
      gene <- c(x,y)
      cat(paste0('\n\nDraw a scatter plot of expression correlation for [',x,'] and [',y,'] genes\n'))
      Plot_Correlation(exp,gene,group,outdir)
    }
  }
}

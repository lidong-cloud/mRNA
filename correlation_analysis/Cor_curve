suppressPackageStartupMessages({
library(argparser)
})

parse <- arg_parser("===================================================================\nThis script is used to analyze the correlation of gene expression and plot correlation curve\n===================================================================",hide.opts = T)

parse <- add_argument(parse, "--degdir", 
    help="The result path of DEG analysis, only one this parameter and file can be provide")
parse <- add_argument(parse, "--file", 
    help="Gene expression files can be divided into three types: 1.They only contain gene expression data. 2.with logFC and P.value. 3.DEG analysis results (such as:DEG/Control__Treat/Gene_expr_diff.xls)")
parse <- add_argument(parse, "--sample", default='All',
    help="Use all samples or only Treat group samples, If you provide file parameter, this parameter is invalid.(optional: All & Treat)")
parse <- add_argument(parse, "--top", default=0.2,
    help="Take the Top correlation value as the result")
parse <- add_argument(parse, "--pvalue", default=0.05,
    help="The pvalue cut off for the correlation ananysis")
parse <- add_argument(parse, "--method", default='pearson',
    help="The method of calculating correlation coefficient (optional: pearson & spearman)")
parse <- add_argument(parse, "--gene",
    help="The genes used to draw correlation curves, and if you don't provide it, I will choose three genes with strong correlation to plot the curve")
parse <- add_argument(parse, "--Point",
    help="Mark the points of these genes on the correlation curve")
parse <- add_argument(parse, "--outdir",
    help="Output directory of this result [default='./GSE*_supp/Correlation/]")

argv <- parse_args(parse)
if(is.na(argv$degdir)==is.na(argv$file)){cat('\nThe parameters <file> and <degdir> must be provided only one\n\n');print(parse);quit()}
if((!is.na(argv$file))&is.na(argv$gene)){cat('\nYou have provided the <file> parameter, and the <gene> parameter is required\n\n');print(parse);quit()}
if(!(argv$sample %in% c('All','Treat'))){cat('\nThe parameter <sample> can only be All and Treat\n\n');print(parse);quit()}
if(!(argv$method %in% c('pearson','spearman'))){cat('\nThe parameter <method> can only be pearson and spearman\n\n');print(parse);quit()}
if(argv$sample == 'Treat' & is.na(argv$degdir)){cat('\nYou cannot select sample if you provide the <file> parameter\n\n')}
degdir <- argv$degdir
file <- argv$file
sample <- argv$sample
top <- as.numeric(argv$top)
pvalue <- as.numeric(argv$pvalue)
method <- argv$method
gene <- argv$gene
point <- argv$Point

if (!is.na(argv$outdir)) {
  outdir <- argv$outdir
}else if(is.na(file)) {
  if(endsWith(strsplit(degdir,'/')[[1]][1],'_supp')) {
    outdir <- paste0(strsplit(degdir,'/')[[1]][1],'/Correlation/')
  }else if(endsWith(strsplit(degdir,'/')[[1]][2],'_supp')) {
    outdir <- paste0(strsplit(degdir,'/')[[1]][2],'/Correlation/')
  }
}else if(!is.na(file)) {
  if(endsWith(strsplit(file,'/')[[1]][1],'_supp')) {
    outdir <- paste0(strsplit(file,'/')[[1]][1],'/Correlation/')
  }else if(endsWith(strsplit(file,'/')[[1]][2],'_supp')) {
    outdir <- paste0(strsplit(file,'/')[[1]][2],'/Correlation/')
  }
}else{outdir <- './supp/Correlation/'}


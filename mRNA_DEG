}

sample_PCA <- function(EXP, Group, outdir){
  EXP <- EXP[apply(EXP,1,var)!=0,]
  pca<- prcomp(t(EXP), scale = T)
  result<-summary(pca)
  x<-result$importance[2,1]*100
  y<-result$importance[2,2]*100
  group2<-data.frame(group = factor(Group))

  data2<-cbind(pca$x,group2)
  sample_name = rownames(data2)
  w <- 3.5 + max(nchar(Group))/12
  col <- c("#4DBBD5FF", "#E64B35FF", "#008B45FF", "palevioletred", "#7E6148FF", "#8491B4FF",
           "lightblue", "#F39B7FFF", "#00A087FF", "#B09C85FF", "#DC0000FF", "#FFD700",
           "#3C5488FF", "#A20056FF", "#91D1C2FF", "#9932CC")
  p<-ggplot(data2,aes(x=data2[,1],y=data2[,2],color=group,label=sample_name))+
      geom_point()+scale_shape_manual(values = rep(c(1:25),times = 4))+
      #stat_ellipse(data=data,geom = "polygon",level = 0.95,linetype = 2,linewidth=0.5,aes(fill=group),alpha=0.05,show.legend = F)+
      #geom_text(aes(label =sample_name),size=2,nudge_x=0,nudge_y=5)+
      scale_color_manual(values=col)+
      labs(x=paste("pc1(",round(x,digits=2),"%)",sep=""),y=paste("pc2(",round(y,digits=2),"%)",sep=""))+theme_bw()+
      theme(axis.title = element_text(size = 15),legend.title = element_text(size=15),legend.text = element_text(size=13))
  
  pdf(paste0(outdir,"/Sample_PCA_correlation.pdf"),w=w,h=3.2)
  print(p);dev.off()
}

Cor_heatmap <- function(exp, Group, outdir){
  col <- c("#4DBBD5FF", "#E64B35FF", "#008B45FF", "palevioletred", "#7E6148FF", "#8491B4FF",
           "lightblue", "#F39B7FFF", "#00A087FF", "#B09C85FF", "#DC0000FF", "#FFD700",
           "#3C5488FF", "#A20056FF", "#91D1C2FF", "#9932CC")
  sampleDists <- as.matrix(cor(exp,method = "spearman"))
  names(col) <- unique(Group)
  right_annotation <- rowAnnotation(group = Group,col = list(group = col[1:length(unique(Group))]),width = unit(3, "cm"),
                                    show_annotation_name = F,show_legend = F,simple_anno_size = unit(0.3, "cm"))
  bottom_annotation <- HeatmapAnnotation(group = Group,col = list(group = col[1:length(unique(Group))]),
                                         show_annotation_name = F,simple_anno_size = unit(0.3, "cm"),
                                         annotation_legend_param = list(title_gp = gpar(fontsize = 25),labels_gp = gpar(fontsize = 21),
                                         grid_width = unit(0.8, "cm"),grid_height = unit(0.8, "cm")))
  
  col_fun <- colorRampPalette(brewer.pal(5,"Blues"))(100)
  if (nrow(sampleDists)>16) {show_name <- F} else {show_name <- T}
  if (nrow(sampleDists)>10) {size <- 14} else {size <- 20}

  w <- 6.3 + max(nchar(Group))/6
  p <- Heatmap(sampleDists,border = F,show_heatmap_legend = T,#column_title = "Samples correlation heatmap\n",
               col = col_fun,cluster_rows = T,cluster_columns = T,
               right_annotation = right_annotation,bottom_annotation = bottom_annotation,
               heatmap_legend_param = list(title = "Spearman",title_gp = gpar(fontsize = 25),labels_gp = gpar(fontsize = 18),
                                           title_position = "leftcenter-rot",legend_height = unit(6, "cm")),
               show_row_names = show_name,show_column_names = show_name,
               row_names_gp = gpar(fontsize = size),column_names_gp = gpar(fontsize = size),
               row_dend_width = unit(10, "mm"),column_dend_height = unit(10, "mm"))
  pdf(paste0(outdir,"/Sample_corr_heatmap.pdf"),w=w,h=6)
  draw(p, merge_legend = TRUE);dev.off()
}


gene_boxplot <- function(EXP,outdir){
  exp_group <- as.data.frame(EXP);h=4.4
  exp_groups <- stack(exp_group) %>% arrange(desc(values))
  exp_groups <- exp_groups[floor(nrow(exp_groups)/100):ceiling(nrow(exp_groups)*99/100),]

  colnames(exp_groups) <- c("Values","Samples")
  p <- ggplot(exp_groups,aes(x=Samples, y=Values, colour=Samples)) +
    geom_boxplot(outlier.shape = NA) + #stat_summary(fun="mean", geom="point", shape=19, size=3,fill="black") +
    xlab("Samples") + ylab("log2(exp+1)") + theme_test() +
    theme(axis.text.x = element_text(angle=45,hjust=1),legend.position = 'none',
          axis.title = element_text(size = 17))
  if (ncol(EXP)>15) {p<-p+theme(axis.ticks.x = element_blank(), axis.text.x = element_blank());h=4}

  pdf(paste0(outdir,"/Sample_EXP_boxplot.pdf"),h=h,w=4)
  print(p);dev.off()
}

density_plot <- function(EXP,outdir){
  df <- as.data.frame(EXP)
  dfs<-stack(df)
  
  p <- ggplot(dfs, aes(x=values))+ 
    geom_density(aes(group=ind, colour=ind, fill=ind), alpha=0.3)+ 
    xlab("log2(exp+1)")+ ylab("density")+ 
    labs(colour="Samples") + theme_test() +
    theme(axis.title = element_text(size = 17),legend.title = element_text(size=17),legend.text = element_text(size=15))
  
  if (ncol(df)<=15) {p <- p + guides(fill='none');w=4.9}
  else {p <- p + theme(legend.position = 'none');w=4}
  
  pdf(paste0(outdir,"/Sample_EXP_density.pdf"),h=4,w=w)

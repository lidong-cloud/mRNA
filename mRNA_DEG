DEG <- function(exp,design,contrast.matrix,adjmethod,logfc,pvalue,deg_dir){
  exp <- exp[,rownames(design)];title <- paste(colnames(design),collapse  = '_VS_')
  exp <- exp[(apply(exp, 1, mean)) > min(exp)+0.01, ]
  Group <- c(rep(colnames(design)[1],nrow(design[design[,1]==1,])),rep(colnames(design)[2],nrow(design[design[,2]==1,])))

  if(ncol(exp)>2){sample_PCA(exp, Group, deg_dir)};Cor_heatmap(exp,Group,deg_dir)

  fit = lmFit(exp,design)
  fit <- contrasts.fit(fit, contrast.matrix)
  fit = eBayes(fit)
  deg = topTable(fit,coef = 1,number = nrow(fit),adjust.method = adjmethod)
  
  deg$regulation <- ifelse((deg$P.Value < pvalue)&(deg$logFC > logfc),"UP",
                           ifelse((deg$P.Value < pvalue)&(deg$logFC < -logfc),"Down","Stable"))
  size <- ifelse(nrow(deg)>5000,0.5,ifelse(nrow(deg)>500,1.5,3))
  
  up <- deg[which(deg$logFC > logfc & deg$P.Value < pvalue),]
  down <- deg[which(deg$logFC < -logfc & deg$P.Value < pvalue),]
  total <- rbind(up,down)
  
  write.table(cbind(Geneid=row.names(deg),exp[row.names(deg),],deg[,-7]), paste0(deg_dir, "/All_Gene_expr.xls"), 
              sep ="\t",quote=F,col.names =T,row.names=F)
  write.table(cbind(Geneid=row.names(up),exp[row.names(up),],up[,-7]), paste0(deg_dir, "/sig_UP_genes.xls"), 
              sep ="\t",quote=F,col.names =T,row.names=F)
  write.table(cbind(Geneid=row.names(down),exp[row.names(down),],down[,-7]), paste0(deg_dir, "/sig_Down_genes.xls"), 
              sep ="\t",quote=F,col.names =T,row.names=F)
  write.table(cbind(Geneid=row.names(total),exp[row.names(total),],total[,-7]), paste0(deg_dir, "/Gene_expr_diff.xls"), 
              sep ="\t",quote=F,col.names =T,row.names=F)
  
  bar_plot(up,down,paste0(deg_dir,'/numbers_of_diff_genes.pdf'))
  
  volcano_plot(deg,title,paste0(deg_dir,'/volcano_plot.pdf'),size)
  
  heatmap_plot(exp,Group,total,deg_dir)
  
  diff_expr_plot(deg,exp,design,paste0(deg_dir,'/diff_expr_plot.pdf'),size)

  MA_plot(deg,paste0(deg_dir,'/MA_plot.pdf'),size)
}

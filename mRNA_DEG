volcano_plot <- function(deg,title,output,size){
  xxx <- substitute(Log[2]*b, list(b="(fold change)"))
  yyy <- substitute(-Log[10]*b, list(b="(pvalue)"))
  #m <- mean(c(15*mean(abs(deg$logFC)),mean(sort(abs(deg$logFC),decreasing =T)[1:20])))
  #n <- 1.1*mean(sort(-log10(deg$P.Value),decreasing=T)[1:100])
  m <- 1.3*quantile(abs(deg$logFC), 0.999)
  n <- 1.3*quantile(-log10(deg$P.Value), 0.999)
  p<-ggplot(data = deg, aes(x = logFC, y = -log10(P.Value))) +
    geom_point(size=size, aes(color=regulation)) +
    scale_color_manual(values=c("UP" = "red","Down" = "blue", "Stable" = "grey80"))+
    scale_x_continuous(expand = c(0,0),limits = c(-m,m))+
    scale_y_continuous(limits = c(0,n))+
    geom_vline(xintercept=c(-logfc,logfc),lty=2,col="gray30",linewidth=0.5) +
    geom_hline(yintercept = -log10(pvalue),lty=2,col="gray30",linewidth=0.5) +
    theme_test() + xlab(xxx) + ylab(yyy) + ggtitle(title) +
    theme(plot.title = element_text(size = 15),axis.title = element_text(size = 15),
        legend.text = element_text(size=13),legend.title = element_text(size=15),
        plot.margin = margin(b = 5,t = 5,l = 5,r = 5))
  pdf(output,w=4.2,h=3.8)
  print(p);dev.off()
}

heatmap_plot <- function(exp,Group,total,deg_dir){
  all <- as.matrix(exp[rownames(total),])
  UP <- total[total$logFC>0,] %>% arrange(desc(logFC))
  Down <- total[total$logFC<0,] %>% arrange(logFC)
  if (nrow(UP)>10) {top_up <- exp[rownames(UP)[seq(1:10)],]}else{top_up <- exp[rownames(UP),]}
  if (nrow(Down)>10) {top_down <- exp[rownames(Down)[seq(1:10)],]}else{top_down <- exp[rownames(Down),]}
  top <- as.matrix(rbind(top_up,top_down))

  for (i in 1:nrow(all)) {all[i,] <- scale(all[i,])};all[all > 3] = 3;all[all < -3] = -3
  for (i in 1:nrow(top)) {top[i,] <- scale(top[i,])};top[top > 3] = 3;top[top < -3] = -3
  col <- c("#4DBBD5FF", "#E64B35FF", "#008B45FF", "palevioletred", "#7E6148FF", "#8491B4FF",
           "lightblue", "#F39B7FFF", "#00A087FF", "#B09C85FF", "#DC0000FF", "#FFD700",
           "#3C5488FF", "#A20056FF", "#91D1C2FF", "#9932CC")
  names(col) <- unique(Group)
  group = HeatmapAnnotation(group = Group,col = list(group = col[1:length(unique(Group))]),show_annotation_name = F,
                            annotation_legend_param = list(title_gp = gpar(fontsize = 19),labels_gp = gpar(fontsize = 16),
                            grid_width = unit(0.7, "cm"),grid_height = unit(0.7, "cm")),simple_anno_size = unit(0.2, "cm"))
  col_fun <- colorRampPalette(rev(brewer.pal(n = 7, name ="RdYlBu")))(50)
  if (ncol(exp)>12) {show_sample <- F;h<-4}else{show_sample <- T;h<-4.8}
  p1<-Heatmap(all,border = F,show_heatmap_legend = T,use_raster = F,
        heatmap_legend_param = list(title = "",labels_gp = gpar(fontsize = 12),title_position = "leftcenter-rot",legend_height = unit(6, "cm")),
        show_row_names = F,show_column_names = show_sample,cluster_rows = T,row_dend_width = unit(10, "mm"),column_names_gp = gpar(fontsize = 15),
        cluster_columns = F,column_names_rot = 60,top_annotation = group,col = col_fun)

  p2<-Heatmap(top,border = F,show_heatmap_legend = T,use_raster = F,
        heatmap_legend_param = list(title = "",labels_gp = gpar(fontsize = 12),title_position = "leftcenter-rot",legend_height = unit(6, "cm")),
        show_row_names = T,show_column_names = show_sample,cluster_rows = T,row_dend_width = unit(10, "mm"),column_names_gp = gpar(fontsize = 15),
        cluster_columns = F,column_names_rot = 60,top_annotation = group,col = col_fun,row_names_gp = gpar(fontsize = 13))
  pdf(paste0(deg_dir,'/heatmap_of_any_diff_genes.pdf'),w=4+max(nchar(Group))/8,h=h)
  draw(p1, merge_legend = TRUE);dev.off()
  pdf(paste0(deg_dir,'/heatmap_of_top_diff_genes.pdf'),w=4+max(nchar(Group))/8+max(nchar(rownames(top)))/10,h=h)
  draw(p2, merge_legend = TRUE);dev.off()
}

diff_expr_plot <- function(deg,exp,design,output,size){
  df <- exp[row.names(deg),rownames(design)]
  df$Control <- rowMeans(df[,design[,1]==1])
  df$Treat <- rowMeans(df[,design[,2]==1])
  df <- cbind(df,regulation=deg$regulation)
  
  xxx <- substitute(a*c(Log[2]*b), list(a=colnames(design)[1], c=" ", b="exp+1"))
  yyy <- substitute(a*c(Log[2]*b), list(a=colnames(design)[2], c=" ", b="exp+1"))
  txt <- paste0("Up genes: ",length(df[df$regulation=='UP',]$regulation),
                "\nDown genes: ",length(df[df$regulation=='Down',]$regulation))
  
  p <- ggplot(df,aes(x=Control,y=Treat))+ 
    geom_point(size=size,aes(color = regulation))+ 
    scale_color_manual(values=c("UP" = "red","Down" = "blue", "Stable" = "grey80"))+
    theme_bw() + xlab(xxx) + ylab(yyy) + ggtitle(txt) +
    theme(plot.title = element_text(size = 15),axis.title = element_text(size = 15),
        legend.text = element_text(size=13),legend.title = element_text(size=15),
        plot.margin = margin(b = 5,t = 5,l = 5,r = 5))
  
  pdf(output,w=4.2,h=3.9)
  print(p);dev.off()
}


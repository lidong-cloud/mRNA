##very very important
read_config <- function(config_file){
  config <- read.csv(config_file,sep = '\t',header = F)

  comps <- unique(config[,3]) %>% na.omit()
  comps <- comps[nchar(comps)>0]

  group <- unlist(strsplit(comps, '__'))
  group <- unique(group)

  group_sample <- list()
  f <- function(x) {g <- strsplit(as.character(x[2]),';')[[1]]
    if (i %in% g) {return(as.character(x[1]))}}
  for (i in group) {group_sample[[i]] <- unique(unlist(apply(config,1,f)))}

  Group <- unlist(lapply(strsplit(config$V2,';'),function(x) x[1]))

  group_group <- list()
  comp_group <- strsplit(comps, '__')
  for (i in 1:length(comp_group)) {
    treat <- paste(group_sample[[comp_group[[i]][1]]],collapse = ',')
    control <- paste(group_sample[[comp_group[[i]][2]]],collapse = ',')
    group_group[[i]] <- c(treat,control)
  }
  select <- config$V1 %in% unique(unlist(strsplit(unlist(group_group),',')))
  samples <- config$V1[select]
  Group <- Group[select]
  
  print("*******************分组信息如下*********************")
  print('差异比较分组: ')
  print(comps)
  print('差异比较样本: ')
  print(group_group)
  print("****************************************************")
  cat('\n\n')

  return(list(samples,Group,comps,group_group))
}

read_exp <- function(exp_file,samples,outdir){
  exp <- readr::read_tsv(exp_file)
  cat("\n=====================Expression matrix loading success===================\n\n")
  exp <- as.data.frame(exp, stringsAsFactors=FALSE) %>% na.omit()

  colnames(exp)[1] <- 'Geneid'
  exp <- exp %>% mutate(sum = rowSums(across(where(is.numeric)))) %>% 
    arrange(Geneid,desc(sum))
  exp <- exp[!duplicated(exp[,1]), 1:(ncol(exp)-1)]
  rownames(exp) <- exp[,1]
  print("重复的基因去掉了(默认保留表达水平最高的)！！！")
  dim(exp)

  exp <- exp[,unique(samples),drop=FALSE]
  print("配置文件中的样品名和表达矩阵里面的样品名配上了！！！")
  
  process_number <- function(x) {n <- x-floor(x);x <- ifelse(n<0.01|n>0.99,round(x),x)}
  Gname <- rownames(exp)

  if (max(exp)>100) {
    exp <- data.frame(lapply(exp, process_number));rownames(exp) <- Gname
    Type <- table(exp%%1==0)['TRUE']/(ncol(exp)*nrow(exp))
    if (is.na(Type)) {Type <- 0}
    if (Type>0.90) {
      design <- cbind(c(rep(1,floor(ncol(exp)/2)),rep(0,ceiling(ncol(exp)/2))), 
                      c(rep(0,floor(ncol(exp)/2)),rep(1,ceiling(ncol(exp)/2))))
      exp <- data.frame(voom(exp,design,normalize="quantile"))
      print('您输入的数据为整数,将您的数据作为Count数进行标准化')
    }else {
      exp <- log2(exp+1)
      print('对该数据进行了log2标准化')
    }
  }

  m <-  min(exp);print(paste0('基因表达最低值: [',m,']'))
  cat(paste0('\n过滤前有表达的数量占比: [',table(exp>m)['TRUE']/(nrow(exp)*ncol(exp)),']\n'))
  exp <- exp[(apply(exp, 1, mean)) > m+0.1, ]
  f<-function(x) sum(x != m)/length(x)
  exp <- exp[(apply(exp,1,f) > 0.2),,drop=FALSE]
  cat(paste0('\n过滤后有表达的数量占比: [',table(exp>m)['TRUE']/(nrow(exp)*ncol(exp)),']\n'))

  readr::write_tsv(cbind(Geneid=row.names(exp),exp), paste0(outdir, "/All_samples_expression.xls"))

  return(exp)
}


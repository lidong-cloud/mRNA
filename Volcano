#!/usr/bin/Rscript
suppressPackageStartupMessages({
library(argparser)
})

parse <- arg_parser("===================================================================\nThis script is used for plot volcano map with Geneid label\n===================================================================",hide.opts = T)

parse <- add_argument(parse, "--file", 
    help="Gene expression file of DEG results (such as: DEG/Treat__Control/All_Gene_expr.xls)")
parse <- add_argument(parse, "--gene",
    help="The Geneid used for add label")
parse <- add_argument(parse, "--modify_group",
    help="You can specify this parameter if you need to modify the group name, such as:Normal__Tumour")
parse <- add_argument(parse, "--outdir", 
    help="Output directory of this result [default: './GSE*_supp/expression/']")
parse <- add_argument(parse, "--logfc",default=0.58,
    help="The logfc cut off for the Volcane plot")
parse <- add_argument(parse, "--pvalue",default=0.05,
    help="The pvalue cut off for the Volcane plot")
parse <- add_argument(parse, "--ratio",default=0.999,
    help="The ratio of display points. If the ratio too large, the points will appear in the middle and lower parts; if it is too small, some important points will be hidden")

argv <- parse_args(parse)
if(is.na(argv$file)|is.na(argv$gene)){cat('\nThe parameters <file> and <gene> is required\n\n');print(parse);quit()}
file <- argv$file
gene <- argv$gene
modify_group <- argv$modify_group
logfc <- as.numeric(argv$logfc)
pvalue <- as.numeric(argv$pvalue)
ratio <- as.numeric(argv$ratio)

if (!is.na(argv$outdir)) {
  outdir <- argv$outdir
}else if(endsWith(strsplit(file,'/')[[1]][1],'_supp')) {
  outdir <- paste0(strsplit(file,'/')[[1]][1],'/expression/')
}else if(endsWith(strsplit(file,'/')[[1]][2],'_supp')) {
  outdir <- paste0(strsplit(file,'/')[[1]][2],'/expression/')
}else{outdir <- './supp/expression'}


suppressPackageStartupMessages({
library(ggplot2)
library(stringr)
library(dplyr)
})

# file <- 'G:/Ledug/Desktop/b-handle/All_Gene_expr.xls'
# gene <- 'KAT6B'
# logfc<-1
# pvalue<-0.05

if(!file.exists(outdir)){dir.create(outdir)}
deg <- read.table(file,header = T,sep = '\t')
deg$regulation <- ifelse((deg$P.Value < pvalue)&(deg$logFC > logfc),"UP",
                         ifelse((deg$P.Value < pvalue)&(deg$logFC < -logfc),"Down","Stable"))
gene <- deg$Geneid[str_to_upper(deg$Geneid) %in% str_to_upper(strsplit(gene,',')[[1]])]
Geneid <- deg[deg$Geneid %in% gene,]
geoid <- gsub('_supp','',strsplit(file,'/')[[1]][grep('_supp',strsplit(file,'/')[[1]])])

m <- 1.3*quantile(abs(deg$logFC), ratio)
n <- 1.3*quantile(-log10(deg$P.Value), ratio)
xxx <- substitute(Log[2]*b, list(b="(fold change)"))
yyy <- substitute(-Log[10]*b, list(b="(pvalue)"))
if (is.na(modify_group)) {title <- gsub('__','_VS_',basename(dirname(file)))}else{title <- gsub('__','_VS_',modify_group)}
size <- ifelse(nrow(deg)>5000,0.5,ifelse(nrow(deg)>500,1.5,3))

p<-ggplot(data = deg, aes(x = logFC, y = -log10(P.Value))) +
  geom_point(size=size, aes(color=regulation)) +
  scale_color_manual(values=c("UP" = "red","Down" = "blue", "Stable" = "grey80"))+
  xlab(xxx) + ylab(yyy) +
  scale_x_continuous(expand = c(0,0),limits = c(-m,m))+
  scale_y_continuous(limits = c(0,n))+
  geom_vline(xintercept=c(-logfc,logfc),lty=2,col="gray30",linewidth=0.5) +
  geom_hline(yintercept = -log10(pvalue),lty=2,col="gray30",linewidth=0.5) +
  theme_test()+ggtitle(paste0(geoid,'\n',title))+
  ggrepel::geom_text_repel(Geneid,mapping = aes(x = logFC, y = -log10(P.Value),label=Geneid),
                           size=5,
                           box.padding = 2, #字到点的距离
                           point.padding = 0.1, #点周围的空白宽度
                           min.segment.length = 0.1, #短线段可以省略
                           segment.size = 0.2,
                           segment.color = "black", #segment.colour = NA, 不显示线段
                           max.overlaps = getOption("ggrepel.max.overlaps", default = 100),
                           show.legend = F)+
  theme(plot.title = element_text(size = 15),axis.title = element_text(size = 15),
        legend.text = element_text(size=13),legend.title = element_text(size=15),
        plot.margin = margin(b = 5,t = 5,l = 5,r = 5))
pdf(paste0(outdir,'/',title,'.',paste(gene,collapse = '_'),'_',logfc,'.volcano.pdf'),w=4.2,h=4.0)
print(p);dev.off()

